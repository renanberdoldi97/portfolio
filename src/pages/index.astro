---
import BaseLayout from '../layouts/BaseLayout.astro';
import Divider from '../components/Divider.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import reguasThumb      from '../assets/cases/reguas-thumb.jpg';
import uraThumb         from '../assets/cases/ura-thumb.jpg';
import duplicidadeThumb from '../assets/cases/duplicidade-thumb.jpg';

const cases = await getCollection('cases', ({ data }) => !data.draft);
cases.sort((a, b) => (a.data.caseNumber ?? '99').localeCompare(b.data.caseNumber ?? '99'));

const featuredCase = cases[0];
const otherCases   = cases.slice(1);

const thumbnailMap: Record<string, ImageMetadata> = {
  'reguas-de-comunicacao': reguasThumb,
  'ura-onboarding':        uraThumb,
  'duplicidade-de-pedidos':duplicidadeThumb,
};

const infoGrid = [
  { label: 'WHERE', value: 'São Paulo, BR' },
  { label: 'WHAT',  value: 'Product Design' },
  { label: 'HOW',   value: 'Pesquisa, dados, sistemas' },
  { label: 'NOW',   value: 'Lead Product Designer @ Nio' },
];
---

<BaseLayout title="Home">

  <!-- ─── 00 / INTRO — Hero ──────────────────── -->
  <section class="mx-auto max-w-4xl px-6 pt-16 pb-0">

    <p class="font-mono text-[13px] text-muted mb-2">00 / 2026</p>
    <p class="text-sm font-medium uppercase tracking-[0.1em] text-primary mb-8">
      Lead Product Designer
    </p>

    <h1
      class="font-display font-normal text-primary leading-[1.0] tracking-[-0.03em] mb-8"
      style="font-size: clamp(3.5rem, 10vw, 8rem)"
    >
      Renan <span class="shimmer-text">Berdoldi</span>
    </h1>

    <p
      class="font-display font-normal text-primary leading-[1.2] mb-16 max-w-3xl"
      style="font-size: clamp(1.5rem, 3vw, 2.5rem)"
    >
      Desenho sistemas que movem indicador,<br class="hidden md:block" />
      não interfaces que decoram tela.
    </p>

    <!-- Info grid -->
    <Divider />
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-y-6 sm:gap-x-8 sm:gap-y-8 md:gap-x-12 md:gap-y-0 py-10 items-start">
      {infoGrid.map(item => (
        <div class="flex flex-col gap-1.5 pr-2">
          <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-muted">
            {item.label}
          </span>
          {item.label === 'WHERE' ? (
            <span class="flex items-center gap-1.5 text-[15px] font-medium text-primary leading-[1.4] flex-wrap">
              São Paulo, BR
              <svg width="22" height="14" viewBox="0 0 22 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:inline;vertical-align:middle;flex-shrink:0;">
                <rect width="22" height="14" rx="2" fill="#009C3B"/>
                <polygon points="11,1.5 20.5,7 11,12.5 1.5,7" fill="#FFDF00"/>
                <circle cx="11" cy="7" r="3" fill="#002776"/>
              </svg>
              (Remoto)
            </span>
          ) : (
            <span class="text-[15px] font-medium text-primary leading-[1.4]">{item.value}</span>
          )}
        </div>
      ))}
    </div>

  </section>

  <!-- ─── 01 / TRABALHO — Cases ──────────────── -->
  <section id="trabalho" class="mx-auto max-w-4xl px-6 pb-20">

    <div class="pt-14 pb-6">
      <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">01 / TRABALHO</p>
    </div>

    <Divider />

    <div class="cases-grid pt-8">

      <!-- Card 01: destaque, layout horizontal -->
      {featuredCase && (
        <a href={`/cases/${featuredCase.id}`} class="case-card case-card-featured">
          <div class="case-card-thumb">
            {thumbnailMap[featuredCase.id] && (
              <Image
                src={thumbnailMap[featuredCase.id]!}
                alt=""
                width={800}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <div class="case-card-content">
            {featuredCase.data.tags && featuredCase.data.tags.length > 0 && (
              <div class="case-tags">{featuredCase.data.tags.join(' · ').toUpperCase()}</div>
            )}
            <span class="font-mono font-medium text-accent block mb-1" style="font-family: var(--font-mono); font-size: 32px; line-height: 1;">
              {featuredCase.data.metric}
            </span>
            <span class="font-mono uppercase text-muted block mb-4" style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em;">
              {featuredCase.data.metricLabel}
            </span>
            <span class="font-display font-medium text-primary block mb-2" style="font-size: 22px; line-height: 1.2;">
              {featuredCase.data.title}
            </span>
            <p class="text-muted mb-6 line-clamp-2" style="font-size: 14px; line-height: 1.5;">
              {featuredCase.data.description}
            </p>
            <span class="card-btn card-btn-primary">Ver caso <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:middle;margin-left:6px;"><polyline points="9 18 15 12 9 6"/></svg></span>
          </div>
        </a>
      )}

      <!-- Cards 02 e 03: lado a lado -->
      {otherCases.length > 0 && (
        <div class="cases-grid-row">
          {otherCases.map(c => (
            <a href={`/cases/${c.id}`} class="case-card">
              {thumbnailMap[c.id] && (
                <Image
                  src={thumbnailMap[c.id]!}
                  alt=""
                  width={500}
                  class="w-full object-cover rounded-[8px] mb-6"
                  style="aspect-ratio: 4/3;"
                  loading="lazy"
                  decoding="async"
                />
              )}
              {c.data.tags && c.data.tags.length > 0 && (
                <div class="case-tags">{c.data.tags.join(' · ').toUpperCase()}</div>
              )}
              <span class="font-mono font-medium text-accent block mb-1" style="font-family: var(--font-mono); font-size: 32px; line-height: 1;">
                {c.data.metric}
              </span>
              <span class="font-mono uppercase text-muted block mb-4" style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em;">
                {c.data.metricLabel}
              </span>
              <span class="font-display font-medium text-primary block mb-2" style="font-size: 22px; line-height: 1.2;">
                {c.data.title}
              </span>
              <p class="text-muted mb-6 line-clamp-2" style="font-size: 14px; line-height: 1.5;">
                {c.data.description}
              </p>
              <span class="card-btn card-btn-secondary">Ver caso <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:middle;margin-left:6px;"><polyline points="9 18 15 12 9 6"/></svg></span>
            </a>
          ))}
        </div>
      )}

    </div>

  </section>

  <!-- ─── 02 / SOBRE ─────────────────────────── -->
  <section id="sobre">
    <div class="mx-auto max-w-4xl px-6 pb-16">
      <Divider />
      <div class="pt-16">
        <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted mb-10">02 / SOBRE</p>

        <h2
          class="font-display font-normal text-primary leading-[1.1] tracking-[-0.02em] mb-6"
          style="font-size: clamp(2rem, 5vw, 3.5rem)"
        >
          Sobre o trabalho
        </h2>

        <p class="leading-[1.65] text-muted max-w-2xl mb-8" style="font-size: clamp(1.0625rem, 1.5vw, 1.125rem)">
          Sou Lead Product Designer com 8 anos de experiência em produtos digitais. Trabalho no
          cruzamento entre design, dados e negócio — desenhando fluxos omnichannel em app, WhatsApp
          e URA. Hoje lidero design dos squads de Onboarding e Uso na Nio Internet.
        </p>

        <a href="/sobre" class="btn">
          Ler mais sobre mim <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:middle;margin-left:6px;"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── 03 / CONTATO ───────────────────────── -->
  <section class="contact-section">
    <div class="mx-auto max-w-4xl px-6">
      <p class="contact-label">03 / CONTATO</p>
      <h2 class="contact-title">Vamos conversar?</h2>
      <p class="contact-subtitle">Aberto a conversas sobre oportunidades, colaborações e projetos interessantes.</p>
      <a href="mailto:renanberdoldi@gmail.com" class="btn-accent">Enviar email</a>
    </div>
  </section>

</BaseLayout>
