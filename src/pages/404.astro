---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada">
  <div class="mx-auto flex max-w-4xl flex-col items-center justify-center px-6 py-32 text-center">
    <p class="mb-4 font-mono text-7xl font-bold text-primary opacity-10">404</p>
    <h1 class="mb-3 font-display text-2xl font-normal tracking-[-0.01em] text-primary">
      Página não encontrada
    </h1>
    <p class="mb-8 text-muted">Esta página não existe ou foi movida.</p>
    <a href="/" class="btn">
      Voltar para o início
    </a>
  </div>
</BaseLayout>
